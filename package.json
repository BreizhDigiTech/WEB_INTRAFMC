{
    "name": "web-intrafmc",
    "version": "1.0.0",
    "description": "Application Vue.js modulaire pour l'intranet FMC - Support de développement vierge",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc && vite build",
        "preview": "vite preview",
        "serve": "vite preview",
        "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
        "type-check": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@vueuse/core": "^10.7.0",
        "jspdf": "^3.0.1",
        "pinia": "^2.1.0",
        "vue": "^3.4.0",
        "vue-router": "^4.2.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.1.11",
        "@types/jspdf": "^1.3.3",
        "@types/node": "^20.10.0",
        "@typescript-eslint/eslint-plugin": "^6.14.0",
        "@typescript-eslint/parser": "^6.14.0",
        "@vitejs/plugin-vue": "^4.5.0",
        "@vue/eslint-config-typescript": "^12.0.0",
        "@vue/tsconfig": "^0.5.0",
        "autoprefixer": "^10.4.21",
        "daisyui": "^5.0.46",
        "eslint": "^8.56.0",
        "eslint-plugin-vue": "^9.18.0",
        "postcss": "^8.5.6",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.3.0",
        "vite": "^5.0.0",
        "vue-tsc": "^1.8.0"
    }
}
