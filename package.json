{
    "name": "web-intrafmc",
    "version": "1.0.0",
    "description": "Application Vue.js modulaire pour l'intranet FMC - Support de développement vierge",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc && vite build",
        "preview": "vite preview",
        "serve": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "type-check": "vue-tsc --noEmit",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:run": "vitest run",
        "test:coverage": "vitest --coverage"
    },
    "dependencies": {
        "@sentry/vue": "^10.5.0",
        "@tanstack/vue-query": "^5.83.1",
        "@vueuse/core": "^10.7.0",
        "dompurify": "^3.2.6",
        "jspdf": "^3.0.1",
        "pinia": "^2.1.0",
        "vue": "^3.4.0",
        "vue-router": "^4.2.0",
        "zod": "^4.0.17"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.1.11",
        "@testing-library/vue": "^8.1.0",
        "@types/jspdf": "^1.3.3",
        "@types/node": "^20.10.0",
        "@typescript-eslint/eslint-plugin": "^6.14.0",
        "@typescript-eslint/parser": "^6.14.0",
        "@vitejs/plugin-vue": "^4.5.0",
        "@vue/eslint-config-typescript": "^12.0.0",
        "@vue/test-utils": "^2.4.6",
        "@vue/tsconfig": "^0.5.0",
        "autoprefixer": "^10.4.21",
        "daisyui": "^5.0.46",
        "eslint": "^8.56.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-vue": "^9.18.0",
        "jsdom": "^26.1.0",
        "postcss": "^8.5.6",
        "prettier": "^3.3.3",
        "tailwindcss": "^3.4.17",
    "typescript": "^5.6.2",
    "vite": "^5.0.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.0.29"
    }
}
